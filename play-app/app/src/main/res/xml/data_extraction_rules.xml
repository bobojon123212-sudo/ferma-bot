<?xml version="1.0" encoding="utf-8"?>
<!-- Резервная копия Google и перенос на новый телефон (Android 12+) -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
